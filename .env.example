# Copiar a .env (no se commitea) y ajustar si hace falta.
POSTGRES_DB=permission
POSTGRES_USER=permission
POSTGRES_PASSWORD=permission

# Puertos publicados en tu maquina
SERVICE_PORT=8081
DB_PORT=5434

# Credenciales de GitHub para bajar el plugin de ci-kit al construir la imagen
# (son las mismas gpr.user y gpr.key de ~/.gradle/gradle.properties). NO commitear el .env.
GPR_USER=
GPR_KEY=
